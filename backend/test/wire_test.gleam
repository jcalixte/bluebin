import bluebin_dev
import simplifile

pub fn written_files_match_wire_gleam_test() {
  let assert Ok(source) = simplifile.read(bluebin_dev.source_path)
  let assert Ok(generated) = bluebin_dev.generate(source)
  let assert Ok(gleam) = simplifile.read(bluebin_dev.gleam_path)
  let assert Ok(typescript) = simplifile.read(bluebin_dev.typescript_path)
  assert gleam == generated.gleam as "run `gleam dev` in backend/"
  assert typescript == generated.typescript as "run `gleam dev` in backend/"
}

pub fn unsupported_field_type_is_refused_test() {
  let source =
    "pub type Line {
  Line(id: String, opened: Dict(String, Int))
}"
  assert bluebin_dev.generate(source)
    == Error("Line.opened has the unsupported type Dict")
}

pub fn nested_records_and_lists_test() {
  let source =
    "pub type BlueBin {
  BlueBin(slot: Int, piece: Option(String))
}

pub type Board {
  Board(
    /// One per slot.
    bins: List(BlueBin),
    marks: List(Option(Float)),
  )
}"
  let assert Ok(generated) = bluebin_dev.generate(source)
  assert generated.typescript
    == "// Generated by `gleam dev` in backend/ from backend/src/bluebin/wire.gleam. Do not edit.

export type BlueBin = {
  slot: number
  piece: string | null
}

export type Board = {
  /** One per slot. */
  bins: BlueBin[]
  marks: (number | null)[]
}
"
  assert generated.gleam
    == "//// Generated by `gleam dev` from `bluebin/wire.gleam`. Do not edit.

import bluebin/wire
import gleam/json

pub fn blue_bin(value: wire.BlueBin) -> json.Json {
  json.object([
    #(\"slot\", json.int(value.slot)),
    #(\"piece\", json.nullable(value.piece, json.string)),
  ])
}

pub fn board(value: wire.Board) -> json.Json {
  json.object([
    #(\"bins\", json.array(value.bins, blue_bin)),
    #(
      \"marks\",
      json.array(value.marks, fn(item) { json.nullable(item, json.float) }),
    ),
  ])
}
"
}

pub fn enums_are_strings_test() {
  let source =
    "/// What the Account may do.
pub type LineRole {
  OwnerRole
  MemberRole
  Viewer
}

pub type Entry {
  Entry(role: LineRole, roles: List(LineRole))
}"
  let assert Ok(generated) = bluebin_dev.generate(source)
  assert generated.typescript
    == "// Generated by `gleam dev` in backend/ from backend/src/bluebin/wire.gleam. Do not edit.

/** What the Account may do. */
export type LineRole = \"owner\" | \"member\" | \"viewer\"

export type Entry = {
  role: LineRole
  roles: LineRole[]
}
"
  assert generated.gleam
    == "//// Generated by `gleam dev` from `bluebin/wire.gleam`. Do not edit.

import bluebin/wire
import gleam/json

pub fn line_role(value: wire.LineRole) -> json.Json {
  json.string(case value {
    wire.OwnerRole -> \"owner\"
    wire.MemberRole -> \"member\"
    wire.Viewer -> \"viewer\"
  })
}

pub fn entry(value: wire.Entry) -> json.Json {
  json.object([
    #(\"role\", line_role(value.role)),
    #(\"roles\", json.array(value.roles, line_role)),
  ])
}
"
}

pub fn unions_are_tagged_by_kind_test() {
  let source =
    "/// The next thing to do.
///
/// One at a time.
pub type NextThing {
  TakeKanban(
    /// The Work Station.
    station: String,
    because: Option(String),
  )
  WaitThing
}"
  let assert Ok(generated) = bluebin_dev.generate(source)
  assert generated.typescript
    == "// Generated by `gleam dev` in backend/ from backend/src/bluebin/wire.gleam. Do not edit.

/**
 * The next thing to do.
 *
 * One at a time.
 */
export type NextThing =
  | {
      kind: \"take_kanban\"
      /** The Work Station. */
      station: string
      because: string | null
    }
  | {
      kind: \"wait\"
    }
"
  assert generated.gleam
    == "//// Generated by `gleam dev` from `bluebin/wire.gleam`. Do not edit.

import bluebin/wire
import gleam/json

pub fn next_thing(value: wire.NextThing) -> json.Json {
  case value {
    wire.TakeKanban(..) as variant ->
      json.object([
        #(\"kind\", json.string(\"take_kanban\")),
        #(\"station\", json.string(variant.station)),
        #(\"because\", json.nullable(variant.because, json.string)),
      ])
    wire.WaitThing -> json.object([#(\"kind\", json.string(\"wait\"))])
  }
}
"
}

pub fn types_the_generator_cannot_write_are_refused_test() {
  assert bluebin_dev.generate("pub type Box(a) {\n  Box(item: a)\n}")
    == Error(
      "Box must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("type Hidden {\n  Hidden(id: String)\n}")
    == Error(
      "Hidden must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("pub type Lone {\n  Lone\n}")
    == Error(
      "Lone must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("pub type Pair {\n  Pair(String, Int)\n}")
    == Error("Pair has a field with no label")
  assert bluebin_dev.generate("pub type Shape {\n  Dot\n  Line(Int)\n}")
    == Error("Line has a field with no label")
  assert bluebin_dev.generate("pub type Item {\n  ReworkItem\n  Rework\n}")
    == Error("Item has two variants with the same kind")
}
