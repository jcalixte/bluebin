pub fn unions_are_tagged_by_kind_test() {
  let source =
    "/// The next thing to do.
///
/// One at a time.
pub type NextThing {
  TakeKanban(
    /// The Work Station.
    station: String,
    because: Option(String),
  )
  WaitThing
}"
  let assert Ok(generated) = bluebin_dev.generate(source)
  assert generated.typescript
    == "// Generated by `gleam dev` in backend/ from backend/src/bluebin/wire.gleam. Do not edit.

/**
 * The next thing to do.
 *
 * One at a time.
 */
export type NextThing =
  | {
      kind: \"take_kanban\"
      /** The Work Station. */
      station: string
      because: string | null
    }
  | {
      kind: \"wait\"
    }
"
  assert generated.gleam
    == "//// Generated by `gleam dev` from `bluebin/wire.gleam`. Do not edit.

import bluebin/wire
import gleam/json

pub fn next_thing(value: wire.NextThing) -> json.Json {
  case value {
    wire.TakeKanban(..) as variant ->
      json.object([
        #(\"kind\", json.string(\"take_kanban\")),
        #(\"station\", json.string(variant.station)),
        #(\"because\", json.nullable(variant.because, json.string)),
      ])
    wire.WaitThing -> json.object([#(\"kind\", json.string(\"wait\"))])
  }
}
"
}

pub fn types_the_generator_cannot_write_are_refused_test() {
  assert bluebin_dev.generate("pub type Box(a) {\n  Box(item: a)\n}")
    == Error(
      "Box must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("type Hidden {\n  Hidden(id: String)\n}")
    == Error(
      "Hidden must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("pub type Lone {\n  Lone\n}")
    == Error(
      "Lone must be public, with no type parameter, and one variant with fields or several variants",
    )
  assert bluebin_dev.generate("pub type Pair {\n  Pair(String, Int)\n}")
    == Error("Pair has a field with no label")
  assert bluebin_dev.generate("pub type Shape {\n  Dot\n  Line(Int)\n}")
    == Error("Line has a field with no label")
  assert bluebin_dev.generate("pub type Item {\n  ReworkItem\n  Rework\n}")
    == Error("Item has two variants with the same kind")
}

pub fn request_bodies_get_decoders_test() {
  let source =
    "pub type Kind {
  PieceKind
  ReworkKind
}

pub type Tag {
  Tag(name: String)
}

pub type Unused {
  Unused(id: String)
}

pub type AssignInput {
  AssignInput(
    kind: Kind,
    /// Who takes it.
    team_member: Option(String),
    tags: List(Tag),
    marks: Option(List(Float)),
  )
}"
  let assert Ok(generated) = bluebin_dev.generate(source)
  assert generated.typescript
    == "// Generated by `gleam dev` in backend/ from backend/src/bluebin/wire.gleam. Do not edit.

export type Kind = \"piece\" | \"rework\"

export type Tag = {
  name: string
}

export type Unused = {
  id: string
}

export type AssignInput = {
  kind: Kind
  /** Who takes it. */
  teamMember?: string | null
  tags: Tag[]
  marks?: number[] | null
}
"
  assert generated.gleam
    == "//// Generated by `gleam dev` from `bluebin/wire.gleam`. Do not edit.

import bluebin/wire
import gleam/dynamic/decode
import gleam/json
import gleam/option.{None}

pub fn kind(value: wire.Kind) -> json.Json {
  json.string(case value {
    wire.PieceKind -> \"piece\"
    wire.ReworkKind -> \"rework\"
  })
}

pub fn kind_decoder() -> decode.Decoder(wire.Kind) {
  use value <- decode.then(decode.string)
  case value {
    \"piece\" -> decode.success(wire.PieceKind)
    \"rework\" -> decode.success(wire.ReworkKind)
    _ -> decode.failure(wire.PieceKind, \"Kind\")
  }
}

pub fn tag(value: wire.Tag) -> json.Json {
  json.object([
    #(\"name\", json.string(value.name)),
  ])
}

pub fn tag_decoder() -> decode.Decoder(wire.Tag) {
  use name <- decode.field(\"name\", decode.string)
  decode.success(wire.Tag(name:))
}

pub fn unused(value: wire.Unused) -> json.Json {
  json.object([
    #(\"id\", json.string(value.id)),
  ])
}

pub fn assign_input_decoder() -> decode.Decoder(wire.AssignInput) {
  use kind <- decode.field(\"kind\", kind_decoder())
  use team_member <- decode.optional_field(
    \"teamMember\",
    None,
    decode.optional(decode.string),
  )
  use tags <- decode.field(\"tags\", decode.list(tag_decoder()))
  use marks <- decode.optional_field(
    \"marks\",
    None,
    decode.optional(decode.list(decode.float)),
  )
  decode.success(wire.AssignInput(kind:, team_member:, tags:, marks:))
}
"
}

pub fn a_union_in_a_request_body_is_refused_test() {
  let source =
    "pub type Shape {
  Dot
  Line(length: Int)
}

pub type DrawInput {
  DrawInput(shape: Shape)
}"
  assert bluebin_dev.generate(source)
    == Error("Shape is a union: the generator writes no decoder for it")
}

/// The body `useDesign.ts` sends, and one of an SPA older than the links.
pub fn generated_decoders_decode_request_bodies_test() {
  let body =
    "{\"labels\": {\"demand\": \"Demand\", \"demands\": \"Demands\", \"piece\": \"Piece\", \"pieces\": \"Pieces\"},
      \"teamMembers\": [{\"id\": \"pe-ada\", \"name\": \"Ada\", \"email\": \"ada@example.com\"}, {\"id\": \"pe-bob\", \"name\": \"Bob\"}],
      \"steps\": [{\"name\": \"Build\", \"stations\": [{\"id\": null, \"name\": \"Web\", \"branch\": null, \"blueBins\": 2, \"teamLeader\": \"pe-ada\", \"teamMembers\": [\"pe-ada\"]}]}]}"
  assert json.parse(body, wire_json.design_input_decoder())
    == Ok(
      wire.DesignInput(
        labels: wire.Labels(
          demand: "Demand",
          demands: "Demands",
          piece: "Piece",
          pieces: "Pieces",
        ),
        team_members: [
          wire.DesignTeamMemberInput(
            id: "pe-ada",
            name: "Ada",
            email: Some("ada@example.com"),
          ),
          wire.DesignTeamMemberInput(id: "pe-bob", name: "Bob", email: None),
        ],
        steps: [
          wire.DesignStepInput(name: "Build", stations: [
            wire.DesignStationInput(
              id: None,
              name: "Web",
              branch: None,
              parent_branch: None,
              blue_bins: 2,
              team_leader: "pe-ada",
              team_members: ["pe-ada"],
            ),
          ]),
        ],
      ),
    )
  let assign = wire_json.assign_input_decoder()
  assert json.parse(
      "{\"kind\": \"rework\", \"id\": \"rw-1\", \"teamMember\": \"pe-ada\"}",
      assign,
    )
    == Ok(wire.AssignInput(
      kind: wire.ReworkKind,
      id: "rw-1",
      team_member: "pe-ada",
    ))
  let assert Error(_) =
    json.parse(
      "{\"kind\": \"bin\", \"id\": \"rw-1\", \"teamMember\": \"pe-ada\"}",
      assign,
    )
  let assert Error(_) =
    json.parse("{\"kind\": \"piece\", \"id\": \"p-1\"}", assign)
  let pull = wire_json.pull_input_decoder()
  let empty = wire.PullInput(station: "ws-web", team_member: None, reason: None)
  assert json.parse("{\"station\": \"ws-web\"}", pull) == Ok(empty)
  assert json.parse("{\"station\": \"ws-web\", \"teamMember\": null}", pull)
    == Ok(empty)
  let assert Error(_) = json.parse("{\"station\": 1}", pull)
}
